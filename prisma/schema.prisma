generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  fullName     String
  email        String     @unique
  phone        String     @unique
  passwordHash String
  role         String     @default("CUSTOMER") // CUSTOMER, SUPER_ADMIN, INVENTORY_MANAGER, SUPPORT
  avatar       String?    // Selected cartoon character avatar ID or image URL
  profession   String?    // e.g. Doctor, Pharmacist, Engineer, Student, Business, Self-employed, etc.
  organization String?    // Workplace / Clinic / Hospital / Company name
  designation  String?    // Title or role
  gender       String?    // Male, Female, Other
  dateOfBirth  String?    // DD/MM/YYYY or YYYY-MM-DD
  bio          String?    // Short about me / note
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  addresses Address[]
  orders    Order[]
  auditLogs AuditLog[]
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  recipientName String
  phone        String
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  pincode      String
  addressType  String   @default("Home") // Home, Work, Clinic
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]
}

model Category {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  description  String?
  icon         String?
  bannerImage  String?
  displayOrder Int           @default(0)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  subcategories Subcategory[]
  products      Product[]
}

model Subcategory {
  id          String    @id @default(cuid())
  categoryId  String
  name        String
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products Product[]
}

model Manufacturer {
  id              String    @id @default(cuid())
  name            String    @unique
  countryOfOrigin String    @default("India")
  licenseNumber   String?
  contactInfo     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  products Product[]
}

model Product {
  id                  String   @id @default(cuid())
  sku                 String   @unique
  name                String
  slug                String   @unique
  genericSaltName     String   // e.g., Metformin, Rifaximin, Insulin Glargine
  categoryId          String
  subcategoryId       String?
  manufacturerId      String?
  form                String   // Tablet, Capsule, Injection/Vial, Syrup, Powder, Device
  strength            String   // e.g. 500mg, 100 IU/ml, 550mg
  packSize            String   // e.g., Strip of 10 Tablets, 10ml Vial, 1 Kit
  mrp                 Int      // in Paise (e.g. 45000 = 450.00 INR)
  sellingPrice        Int      // in Paise
  stock               Int      @default(100)
  scheduleType        String   @default("OTC") // OTC, Schedule H, Schedule H1
  isColdChain         Boolean  @default(false)
  minTempCelsius      Float?   // 2.0
  maxTempCelsius      Float?   // 8.0
  maxOrderQuantity    Int      @default(10)
  description         String
  medicalUses         String
  sideEffects         String?
  contraindications   String?
  storageInstructions String?
  images              String   // JSON array string of image URLs
  isActive            Boolean  @default(true)
  isFeatured          Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  category     Category         @relation(fields: [categoryId], references: [id])
  subcategory  Subcategory?     @relation(fields: [subcategoryId], references: [id])
  manufacturer Manufacturer?    @relation(fields: [manufacturerId], references: [id])
  batches      InventoryBatch[]
  orderItems   OrderItem[]
}

model InventoryBatch {
  id                String   @id @default(cuid())
  productId         String
  batchNumber       String
  manufacturingDate DateTime
  expiryDate        DateTime
  quantityOnHand    Int
  quantityAllocated Int      @default(0)
  quantityAvailable Int
  costPrice         Int      // in Paise
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id                   String    @id @default(cuid())
  orderNumber          String    @unique // e.g., ORD-2026-XXXX
  userId               String
  addressId            String
  orderStatus          String    @default("PENDING_PAYMENT") // PENDING_PAYMENT, PAYMENT_CONFIRMED, PROCESSING, PACKED, SHIPPED, OUT_FOR_DELIVERY, DELIVERED, CANCELLED, REFUNDED
  totalMrpAmount       Int       // in Paise
  totalDiscountAmount  Int       // in Paise
  couponCode           String?
  couponDiscountAmount Int       @default(0)
  deliveryCharge       Int       @default(0)
  coldChainFee         Int       @default(0)
  finalPayableAmount   Int       // in Paise
  isColdChain          Boolean   @default(false)
  customerNotes        String?
  cancellationReason   String?
  createdAt            DateTime  @default(now())
  confirmedAt          DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  updatedAt            DateTime  @updatedAt

  user     User        @relation(fields: [userId], references: [id])
  address  Address     @relation(fields: [addressId], references: [id])
  items    OrderItem[]
  payment  Payment?
  shipment Shipment?
  refunds  Refund[]
}

model OrderItem {
  id                  String @id @default(cuid())
  orderId             String
  productId           String
  productNameSnapshot String
  genericSaltSnapshot String
  strengthSnapshot    String
  formSnapshot        String
  unitPricePaid       Int    // in Paise
  quantity            Int
  totalPrice          Int    // in Paise

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Payment {
  id                String    @id @default(cuid())
  orderId           String    @unique
  razorpayOrderId   String    @unique
  razorpayPaymentId String?   @unique
  razorpaySignature String?
  paymentMethod     String?   // UPI, CARD, NETBANKING, WALLET
  paymentStatus     String    @default("PENDING") // PENDING, CAPTURED, FAILED, REFUNDED
  amountPaise       Int
  currency          String    @default("INR")
  gatewayFeePaise   Int?
  gatewayTaxPaise   Int?
  errorCode         String?
  errorDescription  String?
  capturedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Refund {
  id               String    @id @default(cuid())
  orderId          String
  razorpayRefundId String?   @unique
  amountPaise      Int
  reason           String    // CUSTOMER_CANCELLED, DAMAGED_IN_TRANSIT
  refundStatus     String    @default("INITIATED") // INITIATED, PROCESSED, FAILED
  initiatedBy      String?   // Admin or System
  createdAt        DateTime  @default(now())
  processedAt      DateTime?
  updatedAt        DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Shipment {
  id                      String    @id @default(cuid())
  orderId                 String    @unique
  courierPartnerName      String    // BlueDart Cold-Chain, Delhivery, Shadowfax
  awbNumber               String    @unique
  trackingUrl             String?
  isTemperatureControlled Boolean   @default(false)
  shippedAt               DateTime?
  estimatedDeliveryDate   DateTime?
  deliveredAt             DateTime?
  trackingEventsJson      String?   // JSON array of tracking updates
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id               String   @id @default(cuid())
  userId           String?
  actionType       String   // PRICE_UPDATE, STOCK_OVERRIDE, REFUND_INITIATED, ORDER_STATUS_CHANGE
  targetEntityType String   // Product, Order, Refund
  targetEntityId   String
  oldPayload       String?  // JSON
  newPayload       String?  // JSON
  ipAddress        String?
  notes            String?
  createdAt        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model ContactInquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  subject   String?
  message   String
  status    String   @default("UNREAD") // UNREAD, RESOLVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
