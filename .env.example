# ===================================================
# MEDICARE APPLICATION ENVIRONMENT CONFIGURATION
# ===================================================

# Database SQLite Path
DATABASE_URL="file:./prisma/dev.db"

# JWT Authentication Secret Key
JWT_SECRET="medicare-super-secure-production-jwt-secret-key-2026"

# ---------------------------------------------------
# RAZORPAY PAYMENT GATEWAY CREDENTIALS
# ---------------------------------------------------
# Razorpay Dashboard (https://dashboard.razorpay.com) se apni keys yahan paste karein:
# Test Mode Key (e.g. rzp_test_xxxxxxxxxxxxxx) ya Live Mode Key (e.g. rzp_live_xxxxxxxxxxxxxx)
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID_HERE"
RAZORPAY_KEY_SECRET="YOUR_KEY_SECRET_HERE"

# Client-Side Public Key (Same as RAZORPAY_KEY_ID)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID_HERE"

# Optional: Razorpay Webhook Secret (Settings > Webhooks se milta hai)
RAZORPAY_WEBHOOK_SECRET="YOUR_WEBHOOK_SECRET_HERE"
